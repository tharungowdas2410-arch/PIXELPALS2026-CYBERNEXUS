# ==============================================================================
# CYBERNEXUS — Comprehensive Environment Configuration (Local / Development)
# PS ID: SIH26105 | AI-Powered Continuous Cyber Risk Quantification Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js 16) Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Backend (FastAPI) Core Configuration
# ------------------------------------------------------------------------------
APP_NAME=CYBERNEXUS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security & Authentication (Replace in production via: openssl rand -hex 32)
SECRET_KEY=dev-local-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=cybernexus-platform
JWT_AUDIENCE=cybernexus-api

# Local Database (Default: SQLite for zero-config startup; or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./cybernexus.db
DATABASE_SYNC_URL=sqlite:///./cybernexus.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql+asyncpg://cybernexus:cybernexus@localhost:5432/cybernexus
# DATABASE_SYNC_URL=postgresql+psycopg://cybernexus:cybernexus@localhost:5432/cybernexus

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed Admin Credentials (for seed_data.py)
SEED_ADMIN_EMAIL=ciso@northbridge.example
SEED_ADMIN_PASSWORD=ChangeMe_demo1!

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Attack Paths & Blast Radius)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cybernexusdemo
NEO4J_MAX_DEPTH=6

# ------------------------------------------------------------------------------
# AI Risk Advisor & LLM Engine (Zero-Hallucination RAG)
# ------------------------------------------------------------------------------
AI_ENABLED=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2500

# ------------------------------------------------------------------------------
# Demo & Continuous Telemetry Modes
# ------------------------------------------------------------------------------
DEMO_MODE=true
DEMO_SAFE_MODE=true

# Mock Ingestion Connectors (Phase 11)
SIEM_ENABLED=false
SIEM_API_URL=
SIEM_API_KEY=
SIEM_WEBHOOK_SECRET=

EDR_ENABLED=false
EDR_API_URL=
EDR_API_KEY=
EDR_WEBHOOK_SECRET=

IAM_ENABLED=false
IAM_API_URL=
IAM_API_KEY=
IAM_WEBHOOK_SECRET=

CSPM_ENABLED=false
CSPM_API_URL=
CSPM_API_KEY=
CSPM_WEBHOOK_SECRET=

VULN_ENABLED=false
VULN_API_URL=
VULN_API_KEY=
VULN_WEBHOOK_SECRET=

THREAT_INTEL_ENABLED=false
THREAT_INTEL_API_URL=
THREAT_INTEL_API_KEY=
THREAT_INTEL_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Security, Rate Limiting & Retention Policies
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=30
WEBHOOK_RATE_LIMIT=120
API_RATE_LIMIT=120

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

AUDIT_LOG_RETENTION_DAYS=365
SECURITY_EVENT_RETENTION_DAYS=90
AI_AUDIT_RETENTION_DAYS=180
