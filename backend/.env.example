APP_NAME=CYBERNEXUS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default local database (no extra Postgres role required):
DATABASE_URL=sqlite+aiosqlite:///./cybernexus.db
DATABASE_SYNC_URL=sqlite:///./cybernexus.db

# PostgreSQL (requires a matching role + database, or docker compose):
# DATABASE_URL=postgresql+asyncpg://cybernexus:cybernexus@localhost:5432/cybernexus
# DATABASE_SYNC_URL=postgresql+psycopg://cybernexus:cybernexus@localhost:5432/cybernexus

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SEED_ADMIN_EMAIL=ciso@northbridge.example
SEED_ADMIN_PASSWORD=ChangeMe_demo1!

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cybernexusdemo
NEO4J_MAX_DEPTH=6

# AI Risk Advisor & RAG Engine (Phase 10)
# Zero-hallucination architecture: when OPENAI_API_KEY is empty, platform uses deterministic fallback
AI_ENABLED=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2500

# Continuous Cyber Risk Monitoring & Enterprise Telemetry (Phase 11)
DEMO_MODE=true

SIEM_ENABLED=false
SIEM_API_URL=
SIEM_API_KEY=
SIEM_WEBHOOK_SECRET=

EDR_ENABLED=false
EDR_API_URL=
EDR_API_KEY=
EDR_WEBHOOK_SECRET=

IAM_ENABLED=false
IAM_API_URL=
IAM_API_KEY=
IAM_WEBHOOK_SECRET=

CSPM_ENABLED=false
CSPM_API_URL=
CSPM_API_KEY=
CSPM_WEBHOOK_SECRET=

VULN_ENABLED=false
VULN_API_URL=
VULN_API_KEY=
VULN_WEBHOOK_SECRET=

THREAT_INTEL_ENABLED=false
THREAT_INTEL_API_URL=
THREAT_INTEL_API_KEY=
THREAT_INTEL_WEBHOOK_SECRET=
